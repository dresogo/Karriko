# Dependencies
node_modules/
vendor/

# Build outputs
dist/
build/
target/
.next/
.nuxt/

# Release-Artefakte (Mobile)
*.apk
*.aab
*.ipa

# Logs & temp files
logs/
log/
tmp/
temp/
cache/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*

# Environment & secrets
.env
.env.local
.env.*
*.env
# Ausnahme: dokumentierende Vorlage ohne echte Werte
!.env.example
config/.env
secrets.env
*.token
*.secret

# Private keys & certificates
*.pem
*.key
*.crt
*.pfx
*.p12
id_rsa
id_ed25519
id_ecdsa
*.pub
*.jks
*.keystore
*.cer
*.mobileprovision

# Mobile: Signier- und Dienstkonfiguration (enthalten Schluessel bzw. Passwoerter)
key.properties
android/key.properties
google-services.json
GoogleService-Info.plist

# Cloud credentials
credentials.json
service-account.json
google-credentials.json
aws/credentials
.aws/credentials
gcp-key.json

# Config files with secrets
config/secrets.yml
config/secrets.json
application-prod.yml
application.properties
hibernate.cfg.xml
database.yml
settings.xml
auth.json

# Databases & backups
*.sql
*.sqlite
*.db
dump.sql
backup/
*.bak

# IDE & editor files
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Other sensitive / generated files
# Hinweis: Lockdateien (package-lock.json, yarn.lock, Pipfile.lock, pubspec.lock)
# gehoeren bewusst ins Repository - nur so sind Installationen reproduzierbar
# und nur so kann Dependabot transitive Schwachstellen melden.
personal_access_token.txt
__pycache__/
.pytest_cache/
graphify-out/
coverage/
*.lcov
old_tsx/

# Appwrite: die eingespielte CLI-Konfiguration traegt die echte Projekt- und
# Datenbankkennung und entsteht aus appwrite.config.template.json mit
# `node tools/appwrite-config.mjs`. Die Vorlage ist im Repository, diese nicht.
appwrite/appwrite.config.json

# Appwrite: Umgebungsvariablen einer Function. Hier steht unter anderem das
# Salz fuer den Geraetehash — ein bekanntes Salz ist kein Salz.
appwrite/functions/*/.env

# Sicherungen aus tools/schutz.mjs (E-1.18): alte Fassungen der beiden Dateien
# oben, mit echten Kennungen und dem Salz. Liegen bewusst ausserhalb der
# Function-Ordner, weil `appwrite push` diese komplett hochlaedt.
appwrite/.sicherung/

# Exporte aus tools/appwrite-purge-reviews.mjs. Enthalten Rohantworten und
# Nutzerkennungen und duerfen das Repository nie erreichen. Der alte Standardpfad
# unter notes/reports/ bleibt mit drin, falls ein aelterer Aufruf ihn noch nennt.
notes/exporte/
notes/reports/exporte/

# Legacy / local
_legacy/

# Claude Code: lokale, nutzerspezifische Einstellungen
.claude/settings.local.json
.claude/

# Lokale Exporte aus dem Plan-Dokument, dem Sites-Dokument und der Sitemap.
# Enthalten Anwaltsfragen, Notfallplan und Geschaeftsinterna; das Repo ist
# oeffentlich (T-1.15).
notes/claude_plan/
notes/claude_sites/
notes/Karriko Sitemap.html
