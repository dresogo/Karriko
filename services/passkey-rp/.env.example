# Vorlage. Echte Werte gehoeren NICHT ins Repository.
# Kopieren nach .env und ausfuellen.

# --- WebAuthn ---------------------------------------------------------------
# Die rpId ist unwiderruflich an die Domain gebunden: Passkeys, die unter einer
# rpId erzeugt wurden, sind unter einer anderen wertlos. Es gibt keinen
# Migrationsweg. In der Entwicklung 'localhost' – solche Passkeys funktionieren
# produktiv dann nicht, was beabsichtigt ist.
RP_ID=localhost
RP_NAME=Karriko
# Kommagetrennt. Jeder Host muss die rpId selbst sein oder darunter liegen.
EXPECTED_ORIGINS=http://localhost:8080

# --- Appwrite ---------------------------------------------------------------
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
# Nur die Rechte 'users.read' und 'users.write' sowie Zugriff auf die beiden
# Tabellen unten. Kein 'sessions.write' auf Projektebene.
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
APPWRITE_PASSKEYS_TABLE=passkeys
APPWRITE_CHALLENGES_TABLE=webauthn_challenges

# --- Betrieb ----------------------------------------------------------------
CHALLENGE_TTL_SECONDS=300
PORT=3000
