{
  "name": "karriko-passkey-rp",
  "version": "0.1.0",
  "private": true,
  "description": "WebAuthn Relying Party fuer Karriko. Prueft Passkeys und uebersetzt sie ueber einen Appwrite Custom Token in eine Sitzung.",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "node-appwrite": "^30.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
